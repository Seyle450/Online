Options -Indexes
RewriteEngine On

# ── Eigene Fehlerseite statt der nackten Apache-Meldung ──────────────────────
ErrorDocument 404 /404.html

# ── Apple: Universal-Links-Datei ─────────────────────────────────────────────
# iOS fragt beim Teilen von Links /apple-app-site-association und
# /.well-known/apple-app-site-association ab. Ohne Datei landet jeder dieser
# Aufrufe als 404 im Log. Die Datei sagt schlicht „zu dieser Domain gehört
# keine App" — das ist die korrekte Antwort und beendet die Fehlermeldungen.
# Sie MUSS als application/json ausgeliefert werden und hat bewusst keine
# Dateiendung, deshalb der explizite Content-Type.
<FilesMatch "^apple-app-site-association$">
  ForceType application/json
</FilesMatch>

# .well-known darf nicht blockiert werden (manche Server sperren Punkt-Ordner)
RewriteRule ^\.well-known/ - [L]

# Subdomains für Konzept-Projekte (saubere URLs)
# hevis.elyesferchichi.com → /Webdesign Agentur/hevis/
# bens.elyesferchichi.com  → /Webdesign Agentur/bens/
# usw. — wird über IONOS Control Panel gesteuert

# Lange Ordner-Pfade auf die schönen Subdomains umleiten – ABER nur, wenn der
# Aufruf über die Hauptdomain kommt. Wichtig: RewriteCond gilt in Apache nur für
# die EINE direkt folgende RewriteRule → daher die Bedingung vor JEDER Regel
# wiederholen. Ohne das feuert die Regel auch auf der Subdomain selbst
# (bens.… → bens.…) und erzeugt ERR_TOO_MANY_REDIRECTS.
RewriteCond %{HTTP_HOST} ^elyesferchichi\.com$ [NC]
RewriteRule ^Webdesign-Agentur/antepli-baklava(/.*)?$ https://antepli.elyesferchichi.com$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^elyesferchichi\.com$ [NC]
RewriteRule ^Webdesign-Agentur/hevis(/.*)?$ https://hevis.elyesferchichi.com$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^elyesferchichi\.com$ [NC]
RewriteRule ^Webdesign-Agentur/bens(/.*)?$ https://bens.elyesferchichi.com$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^elyesferchichi\.com$ [NC]
RewriteRule ^Webdesign-Agentur/lokma-lovers(/.*)?$ https://lokma.elyesferchichi.com$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^elyesferchichi\.com$ [NC]
RewriteRule ^Webdesign-Agentur/cafe-niki(/.*)?$ https://niki.elyesferchichi.com$1 [R=301,L]

# webdesign-bremen/ → root (subdomain wurde gelöscht)
RewriteRule ^webdesign-bremen(/.*)?$ https://elyesferchichi.com$1 [R=301,L]

# Freelance.html → root (Datei gelöscht). Ersetzt die alte Meta-Refresh-Hülle:
# echte 301 statt Client-Redirect, damit alte Links/Rankings sauber übergehen.
RewriteRule ^Freelance\.html$ https://elyesferchichi.com/ [R=301,L]
